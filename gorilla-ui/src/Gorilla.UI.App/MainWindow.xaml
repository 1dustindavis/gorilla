<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Gorilla.UI.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gorilla.UI.App.Controls"
    xmlns:local="using:Gorilla.UI.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="App Catalog">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid Padding="20,6,20,4" ColumnDefinitions="*,Auto">
            <Grid x:Name="PageHeaderContext" Margin="0,0,12,0" VerticalAlignment="Center">
                <Grid
                    x:Name="HomeHeaderContext"
                    ColumnDefinitions="*,Auto"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <TextBlock
                        Text="Available Software"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HomeHeading"
                        AutomationProperties.HeadingLevel="Level1" />
                    <Button
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Content="Activity"
                        Click="ActivityNavigationButton_Click"
                        AutomationProperties.AutomationId="ActivityNavigationButton"
                        AutomationProperties.Name="Activity" />
                </Grid>

                <Grid
                    x:Name="DetailsHeaderContext"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Button
                        x:Name="DetailsBackButton"
                        HorizontalAlignment="Left"
                        Click="DetailsBackButton_Click"
                        AutomationProperties.AutomationId="DetailsBackButton"
                        AutomationProperties.Name="Back">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    x:Name="ActivityHeaderContext"
                    ColumnDefinitions="Auto,*,Auto"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Button
                        x:Name="ActivityBackButton"
                        Content="Back"
                        Click="ActivityBackButton_Click"
                        AutomationProperties.AutomationId="ActivityBackButton"
                        AutomationProperties.Name="Back to catalog" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0"
                        Text="Activity"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ActivityHeading"
                        AutomationProperties.HeadingLevel="Level1" />
                    <Button
                        Grid.Column="2"
                        Content="Catalog"
                        Click="CatalogNavigationButton_Click"
                        AutomationProperties.AutomationId="CatalogNavigationButton"
                        AutomationProperties.Name="Catalog" />
                </Grid>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    x:Name="CatalogFreshnessStatus"
                    MaxWidth="220"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    Opacity="0.72"
                    AutomationProperties.AutomationId="CatalogFreshnessStatus" />
                <ProgressRing
                    x:Name="CatalogRefreshProgress"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="CatalogRefreshProgress"
                    AutomationProperties.Name="Refreshing App Catalog" />
                <Button
                    x:Name="RefreshButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="RefreshButton_Click"
                    ToolTipService.ToolTip="Refresh"
                    AutomationProperties.AutomationId="CatalogRefreshButton"
                    AutomationProperties.Name="Refresh App Catalog">
                    <FontIcon
                        Glyph="&#xE72C;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Border
            x:Name="CatalogDegradedBanner"
            Grid.Row="1"
            Margin="20,0,20,4"
            Padding="10,8"
            CornerRadius="6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="CatalogDegradedWarning">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="CatalogDegradedText"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    controls:LiveRegionAnnouncer.IsEnabled="True"
                    AutomationProperties.AutomationId="CatalogDegradedWarningText"
                    AutomationProperties.LiveSetting="Polite" />
                <Expander
                    x:Name="CatalogTechnicalDetails"
                    Header="Technical details"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="CatalogTechnicalDetails"
                    AutomationProperties.Name="Catalog technical details">
                    <TextBox
                        x:Name="CatalogTechnicalDetailsText"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.AutomationId="CatalogTechnicalDetailsContent"
                        AutomationProperties.Name="Catalog technical details content" />
                </Expander>
            </StackPanel>
        </Border>

        <Border
            x:Name="InfrastructureWarningBanner"
            Grid.Row="2"
            Margin="20,0,20,4"
            Padding="10,8"
            CornerRadius="6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="InfrastructureWarning">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="InfrastructureWarningText"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    controls:LiveRegionAnnouncer.IsEnabled="True"
                    AutomationProperties.AutomationId="InfrastructureWarningText"
                    AutomationProperties.LiveSetting="Assertive" />
                <Expander
                    x:Name="InfrastructureTechnicalDetails"
                    Header="Technical details"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="InfrastructureTechnicalDetails"
                    AutomationProperties.Name="Infrastructure warning technical details">
                    <TextBox
                        x:Name="InfrastructureTechnicalDetailsText"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.AutomationId="InfrastructureTechnicalDetailsContent"
                        AutomationProperties.Name="Infrastructure warning technical details content" />
                </Expander>
            </StackPanel>
        </Border>

        <Frame
            x:Name="RootFrame"
            Grid.Row="3"
            AutomationProperties.AutomationId="NavigationFrame"
            AutomationProperties.Name="App Catalog content" />
    </Grid>
</Window>
